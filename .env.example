# Every setting is an ACS_-prefixed environment variable.
# Copy to .env for local development. Never commit a filled-in .env.

# ---- Service identity -------------------------------------------------------
ACS_ENV=dev                              # dev | test | staging | prod
ACS_SERVICE_NAME=rcs-acs
ACS_LOG_LEVEL=INFO
ACS_METRICS_NAMESPACE=RcsAcs

# ---- AWS backing services ---------------------------------------------------
ACS_AWS_REGION=ap-northeast-2
ACS_STORE_BACKEND=memory                 # memory | dynamodb (memory refused in staging/prod)
ACS_TABLE_NAME=rcs-acs
ACS_DYNAMODB_ENDPOINT_URL=               # e.g. http://dynamodb-local:8000

# ---- HTTP surface -----------------------------------------------------------
ACS_CONFIG_PATHS=/,/config,/rcs/config   # deployed clients differ on the path
ACS_DM_PATH=/dm
ACS_XML_CONTENT_TYPE=text/xml
ACS_MAX_QUERY_VALUE_LENGTH=256
# Country code (no +) used to read a national-format MSISDN. Empty refuses one
# rather than guessing a country, which would provision the wrong subscriber.
# Set 82 for the Republic of Korea to accept 01012345678 as +821012345678.
ACS_DEFAULT_COUNTRY_CODE=
ACS_NATIONAL_TRUNK_PREFIX=0

# ---- Provisioning policy ----------------------------------------------------
ACS_DEFAULT_RCS_PROFILE=UP_2.4           # UP_2.4 | UP_1.0 | joyn_blackbird
ACS_PROVISIONING_VALIDITY_SECONDS=86400  # VALIDITY in the VERS characteristic; 0 = no expiry
ACS_MALFORMED_REQUEST_STATUS=400         # some operator ACSs answer 403; see ADR-0006

# ---- Authentication ---------------------------------------------------------
ACS_OTP_LENGTH=6
ACS_OTP_TTL_SECONDS=300
ACS_OTP_MAX_ATTEMPTS=3
ACS_OTP_RESEND_COOLDOWN_SECONDS=60
ACS_OTP_MAX_SENDS_PER_MSISDN_PER_DAY=10
ACS_TOKEN_TTL_SECONDS=2592000
ACS_TOKEN_BIND_IMEI=true

# Empty disables header-enrichment identity entirely. An identity header from an
# untrusted peer is forgeable, so this must list only operator gateway ranges.
ACS_TRUSTED_PROXY_CIDRS=
ACS_ENRICHMENT_HEADER_NAME=X-3GPP-Intended-Identity

# GBA needs a real BSF. Enabled in staging/prod without one, the service fails
# closed rather than faking a bootstrap.
ACS_GBA_ENABLED=false
ACS_GBA_REALM=3GPP-bootstrapping@acs.example.com

# ---- OMA-DM -----------------------------------------------------------------
ACS_DM_ENABLED=true
ACS_DM_SERVER_ID=ACS-DM
ACS_DM_AUTH_SCHEME=basic                 # none | basic | md5
ACS_DM_BOOTSTRAP_IN_CP=true              # emit the w7 characteristic (CP -> DM bridge)
ACS_DM_ACCOUNT_URI=https://acs.example.com/dm
ACS_DM_MAX_MSG_SIZE=16384
ACS_DM_SESSION_TTL_SECONDS=600

# ---- SMS --------------------------------------------------------------------
ACS_SMS_PROVIDER=mock                    # mock | eum | sns | smpp (mock refused in staging/prod)
ACS_SMS_ORIGINATION_IDENTITY=
ACS_SMS_SENDER_ID=RCS
# Also the user data of a port-addressed OTP, after the UDH. One SMS only: longer
# than 160 GSM characters, 70 UCS-2 characters or 133 octets with a UDH is refused.
ACS_SMS_OTP_TEMPLATE=RCS activation code: {otp}

# SMPP 3.4 to an operator SMSC: the only provider that can send a port-addressed
# (silent) OTP when the client supplies SMS_port. One bind_transceiver session per
# message. Host, system id and password are required in staging/prod.
ACS_SMPP_HOST=
ACS_SMPP_PORT=2775                       # 1-65535
ACS_SMPP_SYSTEM_ID=                      # at most 15 characters
ACS_SMPP_PASSWORD=                       # at most 8 characters; from Secrets Manager, never logged
ACS_SMPP_SYSTEM_TYPE=                    # at most 12 characters; often empty
ACS_SMPP_SOURCE_ADDR=                    # empty uses ACS_SMS_SENDER_ID
ACS_SMPP_SOURCE_ADDR_TON=5               # 5 alphanumeric, 1 international
ACS_SMPP_SOURCE_ADDR_NPI=0               # 0 unknown, 1 ISDN (E.164)
ACS_SMPP_DEST_ADDR_TON=1                 # the destination is the E.164 MSISDN without "+"
ACS_SMPP_DEST_ADDR_NPI=1
# SMPP sends the password in clear. Disable TLS only on a private link to the SMSC.
ACS_SMPP_TLS=true
ACS_SMPP_TLS_CA_FILE=                    # CA bundle for an operator private CA
ACS_SMPP_TIMEOUT_SECONDS=10              # per response, above 0 and at most 60

# ---- Operational ------------------------------------------------------------
# Empty means every admin route returns 503. There is no default token.
ACS_ADMIN_TOKEN=
# Exposes /dev/sms (mock SMS outbox). Never true in staging or prod.
ACS_DEV_ENDPOINTS_ENABLED=false
ACS_PII_LOG_MODE=mask                    # mask | hash | none (none refused in staging/prod)
ACS_PII_HASH_SECRET=                     # required for hash mode
ACS_RATE_LIMIT_PER_IP_PER_MINUTE=60
